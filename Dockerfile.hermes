FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install -g pnpm@9.1.1
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY src ./src
COPY tsconfig.json ./
COPY tsup.hermes.config.ts ./
RUN pnpm exec tsup --config tsup.hermes.config.ts
RUN pnpm prune --prod --ignore-scripts

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production DATA_DIR=/data
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist-hermes ./dist-hermes
COPY package.json ./
COPY hermes/app.mjs hermes/client.mjs hermes/triggers.mjs ./hermes/
VOLUME /data
CMD ["node", "/app/hermes/app.mjs"]
