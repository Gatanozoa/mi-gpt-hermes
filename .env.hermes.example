# 桥接镜像地址。
MIGPT_IMAGE=ghcr.io/gatanozoa/mi-gpt-hermes:latest
# 小米 ID，不是手机号或邮箱。
MI_USER=
MI_PASS=
# 米家中的设备名称或 did。
MI_DID=小爱音箱Play
# 型号暂不确定可先用 L05B；如底部标签为 LX05，改成 LX05。
MI_HARDWARE=L05B
# 必填：镜像没有默认触发词，未设置或为空时拒绝启动。
# 以下仅为示例；按需修改，逗号分隔，英文不区分大小写。
MI_AI_KEYWORDS=问问hermes,问问爱马仕,问问赫尔墨斯,告诉爱马仕,告诉赫尔墨斯
# hermes 是 Hermes 服务在共享网络 hermes-voice 上的名称。
HERMES_BASE_URL=http://hermes:8642/v1
# 填写 Hermes API 服务配置的 API_SERVER_KEY。
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=180000
