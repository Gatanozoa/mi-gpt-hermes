# 使用 GitHub Actions 发布后的镜像地址，账户名小写。
MIGPT_IMAGE=ghcr.io/YOUR_GITHUB_ACCOUNT/mi-gpt-hermes:latest
# 小米 ID，不是手机号或邮箱。
MI_USER=
MI_PASS=
# 米家中的设备名称或 did。
MI_DID=小爱音箱Play
# 型号暂不确定可先用 L05B；如底部标签为 LX05，改成 LX05。
MI_HARDWARE=L05B
# 逗号分隔的 Hermes 触发前缀，英文不区分大小写。
MI_AI_KEYWORDS=问问hermes,问问爱马仕,问问赫尔墨斯,告诉爱马仕,告诉赫尔墨斯
HERMES_BASE_URL=http://127.0.0.1:8642/v1
# 复制现有 Hermes 的 API_SERVER_KEY，仅保存在 NAS 的 .env 中。
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_MS=180000
